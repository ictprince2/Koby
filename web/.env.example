# Koby web env — variable names only, no real values.
# Env overrides win; when empty, web/lib/monad.ts applies the MONAD.md-verified
# Monad Testnet defaults (verified Sept 19, 2026 — re-verify against
# docs.monad.xyz before deployment; testnet has been reset before).
# Never commit real secrets. Never hardcode private keys or API keys into code.

# --- Public client config (NEXT_PUBLIC_* — safe to expose) ---
# Human-readable network name (default: Monad Testnet).
NEXT_PUBLIC_CHAIN_NAME=
# Chain ID (integer; default: 10143 Monad Testnet).
NEXT_PUBLIC_CHAIN_ID=
# Public RPC endpoint for reads (default: https://testnet-rpc.monad.xyz).
NEXT_PUBLIC_RPC_URL=
# Deployed Koby financing contract address (empty = not yet deployed;
# the app shows an honest not-deployed state until this is set).
NEXT_PUBLIC_CONTRACT_ADDRESS=
# Block explorer base URL for transaction links (default: MonadVision testnet).
NEXT_PUBLIC_EXPLORER_URL=
# Financing/repayment token (default: verified testnet USDC from MONAD.md
# Section 11; override only for local testing — the contract binds its own
# asset immutably at deploy, so this must match the deployment).
NEXT_PUBLIC_USDC_ADDRESS=
# Privy App ID for wallet onboarding (embedded + external wallets via the
# Privy modal). Empty = Privy onboarding disabled; injected wallets keep
# working. This is a public identifier, never a secret.
NEXT_PUBLIC_PRIVY_APP_ID=
# Official X profile URL for the footer Social section
# (web/lib/social.ts). Empty = the section shows its minimal standby state;
# no link is rendered or invented. Set this when the official account exists.
NEXT_PUBLIC_X_URL=

# --- Server-only (never NEXT_PUBLIC_; never shipped to the client) ---
# KIMI_API_KEY= (Moonshot AI key for the live cash-flow analysis in
# POST /api/analyze via web/services/ai.ts. Empty = deterministic fallback
# labeled Demo AI Assessment. Never expose via NEXT_PUBLIC_*.)
# KIMI_BASE_URL= (default: https://api.moonshot.ai/v1 — Moonshot
# OpenAI-compatible endpoint)
# KIMI_MODEL= (default: kimi-k2.6; override with a current model such as kimi-k3)
# OPENROUTER_API_KEY= (OpenRouter key for the live cash-flow analysis in
# POST /api/analyze via web/services/ai.ts. Empty = this provider is skipped.
# Never expose via NEXT_PUBLIC_*.)
# OPENROUTER_MODEL=qwen/qwen3.8-27b
# (Set a real model ID from https://openrouter.ai/models — verify the exact
# ID including any `:free` suffix there first. An unknown model ID fails
# validation and the route honestly serves the deterministic fallback.)
# NANSEN_API_KEY=
# PRIVY_APP_SECRET=
# USDC_ADDRESS= (Foundry deploy: verified testnet USDC, script/Deploy.s.sol)
# MONAD_TESTNET_RPC= (Foundry deploy RPC endpoint)
